# Copy this file to config/local.env on the Mac. Never commit local.env.
# The GUI reads these values for the direct Jetson connection and optional
# macOS Screen Sharing auto-login.
CUVSLAM_JETSON_HOST=192.168.55.1
CUVSLAM_JETSON_USER=tseng
CUVSLAM_VNC_PASSWORD=replace-with-your-local-vnc-password

# On the Jetson, copy the VNC setting to:
# /home/tseng/isaac_ros_ws/.local.env
# Example (do not commit that file):
# CUVSLAM_VNC_PASSWORD=replace-with-your-local-vnc-password

