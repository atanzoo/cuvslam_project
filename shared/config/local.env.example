# Copy this file to shared/config/local.env on the Mac. Never commit local.env.
# The GUI reads these values for the direct Jetson connection and optional
# macOS Screen Sharing auto-login.
CUVSLAM_JETSON_HOST=192.168.55.1
CUVSLAM_JETSON_USER=tseng
CUVSLAM_VNC_PASSWORD=replace-with-your-local-vnc-password

# Fixed A2M12 mounting calibration. These are the software TF translation and
# yaw from base_link to rplidar_link; keep the physical sensor mount unchanged.
# Leave x/y/z at 0.0 until measured. Leave yaw at 0.0 until orientation is
# confirmed by a labelled motion test.
CUVSLAM_LIDAR_X=0.0
CUVSLAM_LIDAR_Y=0.0
CUVSLAM_LIDAR_Z=0.0
CUVSLAM_LIDAR_YAW=0.0

# On the Jetson, copy the VNC setting to:
# /home/tseng/isaac_ros_ws/.local.env
# Example (do not commit that file):
# CUVSLAM_VNC_PASSWORD=replace-with-your-local-vnc-password
