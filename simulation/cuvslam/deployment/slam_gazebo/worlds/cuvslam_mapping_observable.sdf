          <geometry><box><size>0.34 0.26 0.12</size></box></geometry>
          <material><ambient>0.12 0.26 0.38 1</ambient><diffuse>0.16 0.34 0.50 1</diffuse></material>
        </visual>
      </link>

      <link name="left_wheel">
        <pose>0 0.13 0 1.57079632679 0 0</pose>
        <inertial>
          <mass>0.35</mass>
          <inertia><ixx>0.0007</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0007</iyy><iyz>0</iyz><izz>0.0012</izz></inertia>
