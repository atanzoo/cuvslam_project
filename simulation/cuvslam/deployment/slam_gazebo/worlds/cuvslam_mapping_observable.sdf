    <model name="slam_bot">
      <pose>-1.8 -1.8 0.06 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <pose>-0.01 0 0 0 0 0</pose>
          <mass>8.0</mass>
          <inertia><ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.07</iyy><iyz>0</iyz><izz>0.08</izz></inertia>
        </inertial>
        <collision name="collision">
          <pose>0 0 0.04 0 0 0</pose>
